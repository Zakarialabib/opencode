{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": ["bun", "node"]
  },
  "include": ["opencode-launch.js", "plugins/**/*.ts", "tools/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage", ".nyc_output", "**/__tests__/**", "**/*.test.ts"]
}
