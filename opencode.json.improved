{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/kimi-k2.6",
  "default_agent": "core-factory",
  "enabled_providers": ["opencode", "lmstudio", "opencode-go", "cerebras"],
  "plugin": [
    "C:\\opencode\\plugins\\index.ts",
    "C:\\opencode\\plugins\\agent-router.ts",
    "C:\\opencode\\plugins\\model-router.ts",
    "C:\\opencode\\plugins\\mcp-manager.ts",
    "C:\\opencode\\plugins\\skill-manager.ts",
    "C:\\opencode\\plugins\\context-manager.ts",
    "C:\\opencode\\plugins\\extension-context-bridge.ts",
    "C:\\opencode\\plugins\\ide-mcp-bridge.ts",
    "C:\\opencode\\plugins\\language-context-bridge.ts",
    "C:\\opencode\\plugins\\process-monitor.ts",
    "@zenobius/opencode-skillful"
  ],
  "provider": {
    "opencode": {
      "name": "opencode",
      "options": {},
      "models": {
        "hy3-preview-free": {
          "name": "hy3-preview-free",
          "tool_call": true,
          "reasoning": false
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3.5-4b-claude-4.6-opus-reasoning-distilled-v2": {
          "name": "Qwen3.5-4B Reasoning v2",
          "tool_call": true,
          "reasoning": true
        },
        "gemma-4-e4b-it": {
          "name": "Gemma 4 E4B IT",
          "tool_call": true,
          "reasoning": true
        },
        "qwen3.5-4b": {
          "name": "Qwen3.5-4B Fast",
          "tool_call": true,
          "reasoning": false
        },
        "google/gemma-3n-e4b": {
          "name": "Gemma 3n-e4b (local)",
          "tool_call": true,
          "reasoning": true
        }
      }
    },
    "cerebras": {
      "npm": "@ai-sdk/cerebras",
      "name": "Cerebras",
      "options": {
        "baseURL": "https://api.cerebras.ai/v1",
        "apiKey": "${CEREBRAS_API_KEY}"
      },
      "models": {
        "qwen-3-235b-a22b-instruct-2507": {
          "name": "Qwen 3 235B-A22B",
          "tool_call": true,
          "reasoning": true,
          "supportsInstructions": false
        },
        "zai-glm-4.7": {
          "name": "ZAI GLM 4.7",
          "tool_call": false,
          "reasoning": true,
          "supportsInstructions": false
        }
      }
    },
    "opencode-go": {
      "name": "OpenCode Go (Premium)",
      "models": {
        "kimi-k2.6": {
          "name": "Kimi k2.6",
          "tool_call": true,
          "reasoning": true
        },
        "glm-5.1": {
          "name": "GLM 5.1",
          "tool_call": true,
          "reasoning": true
        },
        "qwen3.6-plus": {
          "name": "Qwen 3.6 Plus",
          "tool_call": true,
          "reasoning": true
        }
      }
    }
  },
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1",
    "mdns": false,
    "cors": ["http://127.0.0.1:8080", "http://"]
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true,
      "timeout": 60000
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": true,
      "timeout": 30000
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "timeout": 15000
    },
    "git": {
      "type": "local",
      "command": ["uvx", "mcp-server-git"],
      "enabled": true,
      "timeout": 20000
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": true,
      "timeout": 15000
    },
    "sqlite": {
      "type": "local",
      "command": ["uvx", "mcp-server-sqlite", "--db-path", "database.sqlite"],
      "enabled": true,
      "timeout": 15000
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true,
      "timeout": 30000
    },
    "language-server": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-language-server"],
      "enabled": true,
      "timeout": 20000
    },
    "type-inject": {
      "type": "local",
      "command": ["npx", "-y", "@nick-vi/type-inject-mcp"],
      "enabled": true,
      "timeout": 20000
    }
  },
  "permission": {
    "skill": {
      "*": "allow",
      "experimental-*": "ask",
      "internal-*": "deny"
    },
    "command": {
      "*": "ask",
      "ls": "allow",
      "dir": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm test*": "allow",
      "cargo check*": "allow",
      "php artisan list*": "allow",
      "rm -rf *": "deny"
    },
    "file": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env*": "deny",
      "**/node_modules/**": "deny",
      "**/.git/**": "deny",
      ".\\**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/node_modules/**": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/node_modules/**": "deny"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "ls": "allow",
      "pwd": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "allow",
    "todoread": "allow",
    "todowrite": "ask",
    "external_directory": {
      ".\\**": "allow",
      "~\\**": "ask"
    },
    "doom_loop": "deny"
  },
  "tools": {
    "read": true,
    "write": true,
    "edit": true,
    "bash": true,
    "glob": true,
    "grep": true,
    "list": true,
    "task": true,
    "skill": true,
    "lsp": true,
    "todoread": true,
    "todowrite": true,
    "webfetch": true,
    "websearch": true,
    "codesearch": true,
    "mcp": true,
    "context7": true,
    "memory": true,
    "filesystem": true,
    "sqlite": true,
    "sequential-thinking": true,
    "language-server": true,
    "type-inject": true
  },
  "lsp": {
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"]
    },
    "php": {
      "command": ["intelephense", "--stdio"],
      "extensions": [".php"],
      "initialization": {
        "storagePath": ".cache\\intelephense"
      }
    },
    "rust": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    },
    "tailwind": {
      "command": ["tailwindcss-language-server", "--stdio"],
      "extensions": [".css", ".html", ".js", ".ts", ".tsx"]
    }
  },
  "formatter": {
    "biome": {
      "disabled": false,
      "command": ["npx", "biome", "format", "--write", "$FILE"],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".json", ".jsonc"]
    },
    "prettier": {
      "disabled": false,
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".css", ".scss", ".html", ".md", ".yaml", ".yml"]
    },
    "pint": {
      "command": ["php", "artisan", "pint", "$FILE"],
      "extensions": [".php"]
    },
    "rustfmt": {
      "command": ["rustfmt", "$FILE"],
      "extensions": [".rs"]
    },
    "shfmt": {
      "command": ["shfmt", "-w", "$FILE"],
      "extensions": [".sh", ".bash"]
    }
  },
  "instructions": [
    "Follow project rules: rules/general.md, rules/project.md, rules/trae.md, rules/laravel-boost.md",
    "Stack: Tauri (Rust), React (TypeScript), Laravel (PHP). Use auto-detect.",
    "Auto-format based on rules/auto-format.md.",
    "REASONING: Always use <thinking> blocks before acting.",
    "ERROR HANDLING: If a tool fails, try one alternative before asking for help.",
    "STYLE: Strict naming conventions and architectural patterns."
  ],
  "command": {
    "audit": {
      "template": "npm run lint && npm test",
      "description": "Full project audit (lint + tests)",
      "agent": "qa-guardian"
    },
    "doctor": {
      "template": "echo 'Config-doctor skill running...'",
      "description": "Audit and repair OpenCode configuration",
      "agent": "lead-strategist"
    },
    "clean": {
      "template": "rm -rf node_modules/.cache vendor/.cache target",
      "description": "Clean project caches",
      "agent": "devops-engineer"
    },
    "build": {
      "template": "npm run build",
      "description": "Build the project",
      "agent": "core-factory"
    },
    "test": {
      "template": "npm test",
      "description": "Run test suite",
      "agent": "qa-guardian"
    },
    "lint": {
      "template": "npm run lint",
      "description": "Run linter checks",
      "agent": "qa-guardian"
    },
    "improve": {
      "template": "echo 'Self-improvement analysis...'",
      "description": "Analyze and enhance configuration",
      "agent": "docs-curator"
    },
    "reflect": {
      "template": "echo 'Self-reflection...'",
      "description": "Analyze opencode config",
      "agent": "docs-curator"
    },
    "db:init": {
      "template": "node tools/db-init.js",
      "description": "Initialize database",
      "agent": "devops-engineer"
    },
    "process:check": {
      "template": "npx ts-node tools/process-check.ts",
      "description": "Check processes and health",
      "agent": "devops-engineer"
    },
    "check-updates": {
      "template": "powershell -File scripts/check-updates.ps1",
      "description": "Check dependency updates",
      "agent": "devops-engineer"
    },
    "db:backup": {
      "template": "powershell -File scripts/db-backup.ps1",
      "description": "Backup database",
      "agent": "devops-engineer"
    }
  },
  "agent": {
    "core-factory": {
      "instructions": [
        "CORE: Fast implementation engine. Always think in <thinking> blocks.",
        "WORKFLOW: Read-Edit-Validate. Use grep/glob for discovery, edit tool with oldString/newString.",
        "If edit fails (not found/multi-match), re-read and add context.",
        "Batch independent reads/edits. Use replaceAll for mass renames – but NOT simple variable name changes.",
        "Use edit, not write, for modifications. Mimic existing code style exactly.",
        "No unnecessary comments. Reference lines as file_path:line_number.",
        "PROJECT STACK: Tauri (Rust), React (TypeScript), Laravel (PHP).",
        "PRIORITY RULES: rules/general.md, rules/tauri.md, rules/react.md, rules/laravel.md, rules/laravel-boost.md.",
        "Auto-format after edits per rules/auto-format.md."
      ],
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "skill": true,
        "grep": true,
        "glob": true,
        "todowrite": true
      },
      "permission": {
        "file": {
          "src/**": "allow",
          "app/**": "allow",
          "resources/**": "allow"
        },
        "read": "allow",
        "edit": "allow",
        "grep": "allow",
        "glob": "allow",
        "command": "ask"
      },
      "description": "Core implementation and direct file editing (merged builder/planner/opencoder)."
    },
    "lead-strategist": {
      "model": "opencode/hy3-preview-free",
      "temperature": 0.2,
      "instructions": [
        "LEAD: Orchestration, architecture, and roadmap. Use <thinking> for strategy.",
        "You have access to skills, LSP, codesearch, and multi-agent task delegation.",
        "When planning: always consider the full stack – Tauri (Rust), React (TypeScript), Laravel (PHP).",
        "Embed project rules: rules/general.md, rules/tauri.md, rules/react.md, rules/laravel.md, rules/laravel-boost.md.",
        "Balance performance, security, and developer experience."
      ],
      "tools": {
        "skill": true,
        "bash": true,
        "read": true,
        "lsp": true,
        "codesearch": true,
        "todowrite": true,
        "task": true
      },
      "description": "Strategic orchestrator, architect, and product lead combined."
    },
    "lead-architect": {
      "model": "opencode/hy3-preview-free",
      "temperature": 0.2,
      "instructions": [
        "LEAD ARCHITECT: Technical vision and structural integrity.",
        "Use MCP Knowledge Graph (memory), Context7 for docs, Sequential Thinking for trade-offs.",
        "Refer to rules/general.md, rules/tauri.md, rules/react.md, rules/laravel.md."
      ],
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "skill": true,
        "lsp": true,
        "codesearch": true,
        "task": true,
        "mcp": true,
        "context7": true,
        "memory": true,
        "sequential-thinking": true
      },
      "description": "Technical vision and long-term structural integrity."
    },
    "frontend-ui-ux": {
      "model": "opencode/hy3-preview-free",
      "temperature": 0.3,
      "instructions": [
        "FRONTEND STACK: Next.js 16, TypeScript, Tailwind CSS 4, shadcn/ui, Prisma ORM. Use fullstack-dev skill for scaffolding.",
        "DESIGN SYSTEM: Use ui-ux-pro-max skill for design patterns, bundled assets, and design system generation.",
        "COMPONENTS: Functional components with explicit React.FC<Props> typing. Use shadcn/ui components as base.",
        "TAILWIND: Use Tailwind 4 utility classes; avoid inline styles. Use `clsx` or `cn` for conditional classes.",
        "RESPONSIVENESS: Design mobile-first; use `sm:`, `md:`, `lg:` breakpoints. Test with Chrome DevTools.",
        "STATE: Prefer React Context + useReducer over prop drilling; use `react-query` for server state, `zustand` for client state.",
        "TAURI BRIDGE: When interacting with Tauri, use `@tauri-apps/api` hooks; handle errors gracefully.",
        "A11Y: Use semantic HTML; add `aria-*` attributes where needed. Target WCAG AA compliance (refer to ui-ux-pro-max/data/ux-guidelines.csv).",
        "PERFORMANCE: Memoize with `React.memo`, lazy-load routes, optimize Core Web Vitals (LCP, FID, CLS).",
        "DESIGN TOKENS: Reference ui-ux-pro-max/data/ for typography (typography.csv), color palettes (styles.csv), and UI patterns (ui-reasoning.csv).",
        "CODE FORMAT: Run `npx biome format` after edits; keep imports sorted. Follow rules/react.md and rules/general.md.",
        "DOCUMENTATION: Use context7_resolve-library-id + context7_query-docs for Next.js, React, Tailwind, shadcn/ui docs.",
        "REUSE: Run react-reuse-audit skill to identify component reuse opportunities before building new components.",
        "OUTPUT: Deliver component code, design token table, accessibility checklist, and UX flow diagram (Mermaid)."
      ],
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "skill": true,
        "lsp": true,
        "codesearch": true,
        "task": true,
        "mcp": true,
        "context7": true,
        "memory": true,
        "sequential-thinking": true
      },
      "description": "Premium UI/UX implementation for Next.js 16 + TypeScript + Tailwind 4 + shadcn/ui."
    },
    "backend-api": {
      "instructions": [
        "BACKEND: API design (Node/Express or Laravel). Use fullstack-dev skills.",
        "Stack: Laravel (PHP) or Node/Express + TypeScript as needed.",
        "Follow rules/laravel.md and rules/project.md.",
        "Use type-inject for PHP type verification when available."
      ],
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "skill": true,
        "lsp": true
      },
      "description": "API implementation and back‑end logic."
    },
    "backend-laravel": {
      "instructions": [
        "Laravel 13 + Livewire 4 + Alpine.js 3 + Tailwind 4 specialist.",
        "Follow rules/laravel.md and rules/laravel-boost.md.",
        "NAMING: Controllers in singular StudlyCase (UserController), Blade files in snake_case (user-profile.blade.php).",
        "LIVEWIRE: Keep components focused; use `wire:model` for form binding, `wire:click` for actions.",
        "ALPINE.JS: Use for micro-interactions; `x-data`, `x-show`; avoid mixing with Livewire state if not needed.",
        "TAILWIND: Use utility classes exclusively; no custom CSS unless absolutely necessary; follow `tailwind.config.js` for theme extension.",
        "VALIDATION: Use Form Requests; validate on Livewire `updated` hooks for real-time feedback.",
        "DATABASE: Use Eloquent with eager loading (`with`) to avoid N+1; always define relationships in models.",
        "ARTISAN: Run `php artisan optimize` after config changes; `php artisan pint` for formatting.",
        "TESTING: Write Pest tests; aim for >80% coverage on critical paths.",
        "LSP: Use `intelephense` for static analysis; fix all errors before committing."
      ],
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "skill": true,
        "lsp": true
      },
      "description": "Specialized Laravel 13 and Livewire 4 development."
    },
    "backend-tauri": {
      "instructions": [
        "Rust/Tauri developer. Follow rules/tauri.md.",
        "Use `cargo check` frequently; never commit without passing.",
        "TAURI IPC: Use `invoke` only from the frontend; keep commands in `src-tauri/src/main.rs` or separate modules.",
        "State management: Use `tauri::State` for shared resources, wrap with `Mutex` or `RwLock`.",
        "Error handling: Return `Result<T, String>` for commands; map errors to user-friendly messages.",
        "Events: Emit events with `app_handle.emit_all`; listen in React via `listen('event-name', ...)`.",
        "Performance: Avoid blocking the main thread; use `async` commands and `tauri::async_runtime::spawn`.",
        "Always run `rust-analyzer` diagnostics before final edits.",
        "For React–Tauri bridging: use `@tauri-apps/api` packages, never direct DOM manipulation bypassing React.",
        "Refer to Tauri v2 documentation, not v1, unless specified."
      ],
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "skill": true,
        "lsp": true
      },
      "description": "Tauri desktop application development (Rust)."
    },
    "qa-guardian": {
      "model": "opencode/hy3-preview-free",
      "temperature": 0.1,
      "instructions": [
        "QUALITY: Code review, testing, security scanning, and debugging.",
        "Use qa-tester skill, security-scan skill, and debug utilities.",
        "Always enforce rules/general.md and project conventions.",
        "Run linting (`npm run lint`) and tests (`npm test`) as needed.",
        "Security: never expose secrets, scan for vulnerabilities."
      ],
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "skill": true,
        "lsp": true
      },
      "description": "Unified QA: review, testing, security, and debugging."
    },
    "devops-engineer": {
      "model": "opencode/hy3-preview-free",
      "temperature": 0.1,
      "instructions": [
        "DEVOPS: Terminal execution, MCP management, system tasks.",
        "Handle db:init, clean, process:check, backups.",
        "Use bash tool with safety checks; avoid destructive commands."
      ],
      "tools": {
        "read": true,
        "bash": true,
        "skill": true
      },
      "description": "Operational tasks, MCP integration, and infrastructure."
    },
    "docs-curator": {
      "model": "opencode/hy3-preview-free",
      "temperature": 0.2,
      "instructions": [
        "KNOWLEDGE: Document, self-improve, and evolve the system.",
        "Update rules/*.md, agents instructions, and project docs.",
        "Use self-improver skill and web research when beneficial.",
        "Execute `doctor` and `improve` commands."
      ],
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "skill": true,
        "codesearch": true,
        "websearch": true,
        "webfetch": true,
        "todowrite": true
      },
      "description": "Documentation, self-improvement, and system evolution."
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  }
}
