{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/hy3-preview-free",
  "default_agent": "core-builder",
  "enabled_providers": [
    "opencode",
    "lmstudio"
  ],
  "plugin": [
    "C:\\opencode\\plugins\\index.ts",
    "C:\\opencode\\plugins\\agent-router.ts",
    "C:\\opencode\\plugins\\mcp-manager.ts",
    "C:\\opencode\\plugins\\skill-manager.ts",
    "C:\\opencode\\plugins\\context-manager.ts",
    "C:\\opencode\\plugins\\extension-context-bridge.ts",
    "C:\\opencode\\plugins\\ide-mcp-bridge.ts",
    "C:\\opencode\\plugins\\language-context-bridge.ts",
    "C:\\opencode\\plugins\\process-monitor.ts",
    "@nick-vi/opencode-type-inject",
    "@tarquinen/opencode-dcp",
    "@zenobius/opencode-skillful"
  ],
  "provider": {
    "opencode": {
      "name": "opencode",
      "options": {},
      "models": {
        "hy3-preview-free": {
          "name": "hy3-preview-free",
          "tool_call": true,
          "reasoning": false
        },
        "hy3-review-free": {
          "name": "hy3-review-free",
          "tool_call": true,
          "reasoning": true
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3.5-4b-claude-4.6-opus-reasoning-distilled-v2": {
          "name": "Qwen3.5-4B Reasoning v2",
          "tool_call": true,
          "reasoning": true
        },
        "gemma-4-e4b-it": {
          "name": "Gemma 4 E4B IT",
          "tool_call": true,
          "reasoning": true
        },
        "qwen3.5-4b": {
          "name": "Qwen3.5-4B Fast",
          "tool_call": true,
          "reasoning": false
        },
        "google/gemma-3n-e4b": {
          "name": "Gemma 3n-e4b (local)",
          "tool_call": true,
          "reasoning": true
        }
      }
    }
  },
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1",
    "mdns": false,
    "cors": [
      "http://127.0.0.1:8080",
      "http://"
    ]
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\opencode"
      ],
      "enabled": true,
      "timeout": 15000
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git"
      ],
      "enabled": true,
      "timeout": 20000
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "enabled": true,
      "timeout": 15000
    },
    "sqlite": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-sqlite",
        "--db-path",
        "C:\\opencode\\database.sqlite"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "language-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-language-server"
      ],
      "enabled": true,
      "timeout": 20000
    },
    "type-inject": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@nick-vi/type-inject-mcp"
      ],
      "enabled": true,
      "timeout": 20000
    }
  },
  "permission": {
    "skill": {
      "*": "allow",
      "experimental-*": "ask",
      "internal-*": "deny"
    },
    "command": {
      "*": "ask",
      "ls": "allow",
      "dir": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm test*": "allow",
      "cargo check*": "allow",
      "php artisan list*": "allow",
      "rm -rf *": "deny"
    },
    "file": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env*": "deny",
      "**/node_modules/**": "deny",
      "**/.git/**": "deny",
      "C:\\opencode\\**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/node_modules/**": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/node_modules/**": "deny"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "ls": "allow",
      "pwd": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "allow",
    "todoread": "allow",
    "todowrite": "ask",
    "external_directory": {
      "C:\\opencode\\**": "allow",
      "~\\**": "ask"
    },
    "doom_loop": "deny"
  },
  "tools": {
    "write": true,
    "edit": true,
    "bash": true,
    "read": true,
    "glob": true,
    "grep": true,
    "list": true,
    "task": true,
    "skill": true,
    "lsp": true,
    "todoread": true,
    "todowrite": true,
    "webfetch": true,
    "websearch": true,
    "codesearch": true
  },
  "lsp": {
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    },
    "php": {
      "command": [
        "intelephense",
        "--stdio"
      ],
      "extensions": [
        ".php"
      ],
      "initialization": {
        "storagePath": "C:\\opencode\\.cache\\intelephense"
      }
    },
    "rust": {
      "command": [
        "rust-analyzer"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "tailwind": {
      "command": [
        "tailwindcss-language-server",
        "--stdio"
      ],
      "extensions": [
        ".css",
        ".html",
        ".js",
        ".ts",
        ".tsx"
      ]
    }
  },
  "formatter": {
    "biome": {
      "disabled": false,
      "command": [
        "npx",
        "biome",
        "format",
        "--write",
        "$FILE"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".json",
        ".jsonc"
      ]
    },
    "prettier": {
      "disabled": false,
      "command": [
        "npx",
        "prettier",
        "--write",
        "$FILE"
      ],
      "extensions": [
        ".css",
        ".scss",
        ".html",
        ".md",
        ".yaml",
        ".yml"
      ]
    },
    "pint": {
      "command": [
        "php",
        "artisan",
        "pint",
        "$FILE"
      ],
      "extensions": [
        ".php"
      ]
    },
    "rustfmt": {
      "command": [
        "rustfmt",
        "$FILE"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "shfmt": {
      "command": [
        "shfmt",
        "-w",
        "$FILE"
      ],
      "extensions": [
        ".sh",
        ".bash"
      ]
    }
  },
  "instructions": [
    "Follow project rules: rules/general.md, rules/project.md, rules/trae.md, rules/laravel-boost.md",
    "Stack-specific rules: rules/tauri.md (Rust/Tauri), rules/react.md (TypeScript/React), rules/laravel.md (PHP/Laravel), rules/laravel-boost.md (AI-Driven Laravel)",
    "Auto-format rule: rules/auto-format.md (language-based formatter selection)",
    "Use stack-context skill to auto-detect stack and pull Context7 docs for Tauri/React/Laravel",
    "Use self-improver skill to learn from docs, LSPs, and adapt features from OpenClaude/ClaudeCode/QwenCode",
    "Prioritize Trae IDE integration and MCP service reuse where applicable",
    "Maintain code readability, test coverage, and performance",
    "Use approved skills for specialized tasks (testing, docs, Laravel, etc.)",
    "REASONING: Always use <thinking> blocks to explain your strategy before calling tools.",
    "ERROR HANDLING: If a tool fails, analyze the error and try one alternative approach before asking for help.",
    "STYLE: Maintain strict adherence to project naming conventions and architectural patterns."
  ],
  "command": {
    "audit": {
      "template": "npm run lint && npm test",
      "description": "Run a full project audit (linting and tests)",
      "agent": "qa-reviewer"
    },
    "doctor": {
      "template": "echo 'Running config-doctor skill...'",
      "description": "Audit and repair OpenCode configuration",
      "agent": "lead-orchestrator"
    },
    "clean": {
      "template": "rm -rf node_modules/.cache vendor/.cache target",
      "description": "Clean up project caches and temporary files",
      "agent": "devops-ops"
    },
    "build": {
      "template": "npm run build",
      "description": "Build the project using npm",
      "agent": "core-builder"
    },
    "test": {
      "template": "npm test",
      "description": "Run project test suite",
      "agent": "qa-tester"
    },
    "lint": {
      "template": "npm run lint",
      "description": "Run linter checks",
      "agent": "qa-reviewer"
    },
    "improve": {
      "template": "echo 'Running self-improvement analysis...'",
      "description": "Analyze and enhance project configuration",
      "agent": "docs-evolver"
    },
    "reflect": {
      "template": "echo 'Running self-reflection...'",
      "description": "Analyze and improve opencode configuration",
      "agent": "docs-evolver"
    },
    "db:init": {
      "template": "node tools/db-init.js",
      "description": "Initialize database with schema and seed data",
      "agent": "devops-ops"
    },
    "process:check": {
      "template": "npx ts-node tools/process-check.ts",
      "description": "Check running processes and system health",
      "agent": "devops-ops"
    },
    "check-updates": {
      "template": "powershell -File scripts/check-updates.ps1",
      "description": "Check for available updates to dependencies",
      "agent": "devops-ops"
    },
    "db:backup": {
      "template": "powershell -File scripts/db-backup.ps1",
      "description": "Backup database to local file",
      "agent": "devops-ops"
    }
  },
  "agent": {
    "core-builder": {
      "instructions": [
        "CORE: High-speed implementation and direct file modification.",
        "REASONING: Always use <thinking> blocks to explain your strategy before calling tools.",
        "",
        "WORKFLOW PATTERNS:",
        "1. Read-Edit-Validate: Always read file first, use edit tool with oldString/newString, validate result",
        "2. Uniqueness: If multiple matches found, provide more surrounding context in oldString",
        "3. Batch tool calls: Group independent reads/edits in single message for speed",
        "4. Use edit tool (not write) for modifications - preserves file structure",
        "5. Use replaceAll for renaming variables/patterns across file",
        "",
        "ERROR RECOVERY:",
        "- STRICT: Use oldString and newString as keys for the edit tool. NEVER use oldText/newText.",
        "- If edit fails (oldString not found), read file again to get fresh context",
        "- If multiple matches found, provide more surrounding context to uniquely identify",
        "- On tool errors, retry with adjusted parameters before escalating",
        "",
        "EFFICIENCY RULES:",
        "- Use grep/glob to find files/patterns before reading (avoid sequential searches)",
        "- Use LSP to verify syntax after edits when available",
        "- Mimic existing code style, naming conventions, and patterns exactly",
        "- Never add unnecessary comments unless explicitly requested",
        "- Minimize output tokens - answer concisely with file_path:line_number references"
      ],
      "temperature": 0.2,
      "tools": {
        "skill": false,
        "command": true,
        "file": true,
        "read": true,
        "edit": true,
        "grep": true,
        "glob": true,
        "lsp": true,
        "todowrite": true
      },
      "permission": {
        "file": {
          "*": "ask",
          "src/**": "allow",
          "app/**": "allow",
          "resources/**": "allow"
        },
        "read": "allow",
        "edit": "allow",
        "grep": "allow",
        "glob": "allow",
        "command": "ask"
      },
      "description": "CORE: High-speed implementation and direct file modification."
    },
