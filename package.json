{
  "name": "opencode-local",
  "version": "1.0.0",
  "bin": {
    "opencode": "./opencode-launch.js"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.45",
    "@nick-vi/opencode-type-inject": "latest",
    "@opencode-ai/plugin": "^1.14.31",
    "@tarquinen/opencode-dcp": "latest",
    "@zenobius/opencode-skillful": "latest",
    "agentic-cli": "^0.1.9",
    "ajv": "^8.17.1",
    "opencode-background-agents": "^0.1.1",
    "opencode-notify": "^0.3.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.3.11",
    "@types/node": "^22.19.17",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.8.2",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "start": "node opencode-launch.js",
    "setup": "powershell -ExecutionPolicy Bypass -File setup.ps1",
    "db:init": "node tools/db-init.js",
    "lint": "npm run lint:biome && npm run lint:prettier",
    "lint:biome": "npx @biomejs/biome format --write .",
    "lint:prettier": "npx prettier --write .",
    "config:validate": "node config-validator.js opencode.json config-schema.json",
    "health-check": "node tools/project-health-check.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"const fs = require('fs'); ['dist', '.nyc_output', 'coverage'].forEach(d => fs.rmSync(d, { recursive: true, force: true }))\"",
    "check-all": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run config:validate"
  }
}
